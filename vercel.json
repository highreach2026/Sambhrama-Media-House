{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/dark/creative-agency.html", "permanent": false },
    { "source": "/index.html", "destination": "/dark/creative-agency.html", "permanent": false },
    { "source": "/home", "destination": "/dark/creative-agency.html", "permanent": false },
    { "source": "/creative-agency", "destination": "/dark/creative-agency.html", "permanent": false },
    { "source": "/creative-agency.html", "destination": "/dark/creative-agency.html", "permanent": false },
    { "source": "/contact", "destination": "/dark/contact.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/_nuxt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
